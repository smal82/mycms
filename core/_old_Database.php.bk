        $stmt = $this->pdo->prepare("SELECT c.* FROM " . $this->table('categories') . " c 
                                     INNER JOIN " . $this->table('post_categories') . " pc ON c.id = pc.category_id 
                                     WHERE pc.post_id = ?");
        $stmt->execute([$postId]);
        return $stmt->fetchAll();
    }
    
